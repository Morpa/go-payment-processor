#!/usr/bin/env bash
# Roda build, vet e testes antes de cada push; se falhar, o push (e o PR) é bloqueado.
# Para pular em um push pontual: git push --no-verify.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

step() {
  echo "==> $*"
  if ! "$@"; then
    echo "pre-push: '$*' falhou — push bloqueado." >&2
    exit 1
  fi
}

step go build ./...
step go vet ./...
step go test ./...
